# Copie para .env e preencha. NUNCA envie o .env ao Git nem inclua no zip.
# Sem estas variáveis o jogo funciona normalmente, com as falas pré-escritas.

# Gemini (juiz Augusto Valença). O nome do modelo vem da documentação atual do Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcionais
# Tempo máximo de espera por resposta da IA, em segundos (1 a 60). Padrão: 8
IA_TIMEOUT_SEGUNDOS=
# Limite de tokens da resposta (64 a 2048). Padrão: 512
IA_MAX_TOKENS_SAIDA=
# Ordem dos provedores por juiz. O "local" é sempre o último. Padrão: formalista:gemini,local
# Exemplo: formalista:gemini,local;pragmatico:local;cinico:local
IA_CADEIAS=

# Reservados para a Etapa 6
GROQ_API_KEY=
GROQ_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
